# Copia este archivo como .env y completa los valores.

# Usuario y clave del esquema en Oracle Autonomous Database (por ejemplo ADMIN).
DB_USER=ADMIN
DB_PASSWORD=

# Alias de tnsnames.ora: _tp (transaccional), _low, _medium, _high o _tpurgent.
DB_DSN=ut9bjwcq3z8a1dug_tp

# Carpeta del wallet (relativa a esta carpeta o absoluta) y la clave que se
# eligió al descargarlo desde la consola de OCI (protege ewallet.pem).
WALLET_DIR=../wallet
WALLET_PASSWORD=
